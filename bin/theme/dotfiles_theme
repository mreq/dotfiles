#!/bin/bash
# shellcheck disable=SC2154

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DOTFILES_DIR=${DOTFILES_DIR:-$(cd -- "$SCRIPT_DIR/../.." && pwd)}
CONFIG_DIR="$DOTFILES_DIR/config"
THEME_DIR="$CONFIG_DIR/theme"
PALETTE_DIR="$THEME_DIR/palettes"
SUBLIME_SOURCE_DIR="$THEME_DIR/sublime"
TMP_DIR="$THEME_DIR/tmp"
CURRENT_FILE="$TMP_DIR/current"

SWAY_COLORS="$TMP_DIR/sway-colors.conf"
FOOT_THEME="$TMP_DIR/foot.ini"
TMUX_THEME="$TMP_DIR/tmux.conf"
WAYBAR_THEME="$TMP_DIR/waybar.css"
GTK_THEME="$TMP_DIR/gtk.css"
ROFI_THEME="$TMP_DIR/rofi-variables.rasi"
SUBLIME_THEME="$TMP_DIR/Mariana.sublime-color-scheme"

BASE_KEYS=(
	base00 base01 base02 base03 base04 base05 base06 base07
	base08 base09 base0A base0B base0C base0D base0E base0F
)

PALETTE_KEYS=(
	"${BASE_KEYS[@]}"
	focus focus_foreground selection selection_foreground
)

TERMINAL_KEYS=(
	terminal_background terminal_foreground terminal_selection_foreground
	terminal_selection_background terminal_cursor terminal_focus
	terminal_focus_foreground
	terminal_color0 terminal_color1 terminal_color2 terminal_color3
	terminal_color4 terminal_color5 terminal_color6 terminal_color7
	terminal_color8 terminal_color9 terminal_color10 terminal_color11
	terminal_color12 terminal_color13 terminal_color14 terminal_color15
)

GENERATED_FILES=(
	"$SWAY_COLORS"
	"$FOOT_THEME"
	"$TMUX_THEME"
	"$WAYBAR_THEME"
	"$GTK_THEME"
	"$ROFI_THEME"
	"$SUBLIME_THEME"
)

usage() {
	cat <<EOF
Usage: dotfiles_theme dark|light|toggle|current|ensure
EOF
}

die() {
	echo "dotfiles_theme: $*" >&2
	exit 1
}

theme_exists() {
	[[ -f "$PALETTE_DIR/$1.sh" ]]
}

normalize_theme() {
	case "${1:-}" in
	dark | light)
		printf '%s\n' "$1"
		;;
	*)
		die "unknown theme '$1'"
		;;
	esac
}

current_theme() {
	if [[ -f "$CURRENT_FILE" ]]; then
		normalize_theme "$(<"$CURRENT_FILE")"
	else
		printf '%s\n' dark
	fi
}

validate_hex() {
	local name=$1
	local value=$2

	[[ $value =~ ^#[0-9a-fA-F]{6}$ ]] || die "$name must be #RRGGBB, got '$value'"
}

load_palette() {
	local theme=$1
	local key

	theme=$(normalize_theme "$theme")
	theme_exists "$theme" || die "missing palette for '$theme'"

	# shellcheck source=/dev/null
	source "$PALETTE_DIR/$theme.sh"

	for key in "${PALETTE_KEYS[@]}" "${TERMINAL_KEYS[@]}"; do
		[[ -n ${!key:-} ]] || die "palette '$theme' is missing '$key'"
		validate_hex "$key" "${!key}"
	done
}

strip_hash() {
	printf '%s' "${1#\#}"
}

atomic_write() {
	local target=$1
	local tmp

	mkdir -p -- "$(dirname -- "$target")"
	tmp=$(mktemp "${target}.tmp.XXXXXX")
	cat >"$tmp"
	mv -- "$tmp" "$target"
}

write_sway_colors() {
	atomic_write "$SWAY_COLORS" <<EOF
# Generated by bin/theme/dotfiles_theme. Do not edit directly.
set \$base00 $base00
set \$base01 $base01
set \$base02 $base02
set \$base03 $base03
set \$base04 $base04
set \$base05 $base05
set \$base06 $base06
set \$base07 $base07
set \$base08 $base08
set \$base09 $base09
set \$base0A $base0A
set \$base0B $base0B
set \$base0C $base0C
set \$base0D $base0D
set \$base0E $base0E
set \$base0F $base0F
set \$base-focus $focus
set \$base-focus-foreground $focus_foreground
EOF
}

write_foot_color_section() (
	local section=$1
	local theme=$2

	load_palette "$theme"

	cat <<EOF
[$section]
background=$(strip_hash "$terminal_background")
foreground=$(strip_hash "$terminal_foreground")
selection-foreground=$(strip_hash "$terminal_selection_foreground")
selection-background=$(strip_hash "$terminal_selection_background")
cursor=$(strip_hash "$terminal_background") $(strip_hash "$terminal_cursor")

regular0=$(strip_hash "$terminal_color0")
regular1=$(strip_hash "$terminal_color1")
regular2=$(strip_hash "$terminal_color2")
regular3=$(strip_hash "$terminal_color3")
regular4=$(strip_hash "$terminal_color4")
regular5=$(strip_hash "$terminal_color5")
regular6=$(strip_hash "$terminal_color6")
regular7=$(strip_hash "$terminal_color7")

bright0=$(strip_hash "$terminal_color8")
bright1=$(strip_hash "$terminal_color9")
bright2=$(strip_hash "$terminal_color10")
bright3=$(strip_hash "$terminal_color11")
bright4=$(strip_hash "$terminal_color12")
bright5=$(strip_hash "$terminal_color13")
bright6=$(strip_hash "$terminal_color14")
bright7=$(strip_hash "$terminal_color15")
EOF
)

write_foot_theme() {
	local theme=$1
	local initial_color_theme=1

	[[ $theme == light ]] && initial_color_theme=2

	{
		cat <<EOF
# Generated by bin/theme/dotfiles_theme. Do not edit directly.
initial-color-theme=$initial_color_theme

EOF
		write_foot_color_section colors dark
		printf '\n'
		write_foot_color_section colors2 light
	} | atomic_write "$FOOT_THEME"
}

write_tmux_theme() {
	atomic_write "$TMUX_THEME" <<EOF
# Generated by bin/theme/dotfiles_theme. Do not edit directly.
set -g status-style "fg=$terminal_foreground,bg=$terminal_background"
set -g message-style "fg=$terminal_focus_foreground,bg=$terminal_focus"
set -g message-command-style "fg=$terminal_focus_foreground,bg=$terminal_focus"
set -g mode-style "fg=$terminal_focus_foreground,bg=$terminal_focus"
set-window-option -g window-status-current-style "fg=$terminal_focus_foreground,bg=$terminal_focus"
set-window-option -g window-status-activity-style "fg=$terminal_color2,bg=$terminal_color1"
set-window-option -g clock-mode-colour "$terminal_color4"
EOF
}

write_waybar_theme() {
	atomic_write "$WAYBAR_THEME" <<EOF
/* Generated by bin/theme/dotfiles_theme. Do not edit directly. */
@define-color base00 $base00;
@define-color base01 $base01;
@define-color base02 $base02;
@define-color base03 $base03;
@define-color base04 $base04;
@define-color base05 $base05;
@define-color base06 $base06;
@define-color base07 $base07;
@define-color base08 $base08;
@define-color base09 $base09;
@define-color base0A $base0A;
@define-color base0B $base0B;
@define-color base0C $base0C;
@define-color base0D $base0D;
@define-color base0E $base0E;
@define-color base0F $base0F;

@define-color base-blackey @base00;
@define-color base-blue @base0D;
@define-color base-brown @base0F;
@define-color base-green @base0B;
@define-color base-orange @base09;
@define-color base-purple @base0E;
@define-color base-red @base08;
@define-color base-turqoise @base0C;
@define-color base-whitey @base07;
@define-color base-yellow @base0A;

@define-color base-focus $focus;
@define-color base-color-on-focus $focus_foreground;
EOF
}

write_gtk_theme() {
	atomic_write "$GTK_THEME" <<EOF
/* Generated by bin/theme/dotfiles_theme. Do not edit directly. */
:root {
  --base00: $base00;
  --base01: $base01;
  --base02: $base02;
  --base03: $base03;
  --base04: $base04;
  --base05: $base05;
  --base06: $base06;
  --base07: $base07;
  --base08: $base08;
  --base09: $base09;
  --base0A: $base0A;
  --base0B: $base0B;
  --base0C: $base0C;
  --base0D: $base0D;
  --base0E: $base0E;
  --base0F: $base0F;
}

@define-color base00 $base00;
@define-color base01 $base01;
@define-color base02 $base02;
@define-color base03 $base03;
@define-color base04 $base04;
@define-color base05 $base05;
@define-color base06 $base06;
@define-color base07 $base07;
@define-color base08 $base08;
@define-color base09 $base09;
@define-color base0A $base0A;
@define-color base0B $base0B;
@define-color base0C $base0C;
@define-color base0D $base0D;
@define-color base0E $base0E;
@define-color base0F $base0F;

@define-color base-blackey @base00;
@define-color base-blue @base0D;
@define-color base-brown @base0F;
@define-color base-green @base0B;
@define-color base-orange @base09;
@define-color base-purple @base0E;
@define-color base-red @base08;
@define-color base-turqoise @base0C;
@define-color base-whitey @base07;
@define-color base-yellow @base0A;

@define-color base-focus $focus;
@define-color base-color-on-focus $focus_foreground;
EOF
}

write_rofi_theme() {
	atomic_write "$ROFI_THEME" <<EOF
/* Generated by bin/theme/dotfiles_theme. Do not edit directly. */
* {
  base00: $base00;
  base01: $base01;
  base02: $base02;
  base03: $base03;
  base04: $base04;
  base05: $base05;
  base06: $base06;
  base07: $base07;
  base08: $base08;
  base09: $base09;
  base0A: $base0A;
  base0B: $base0B;
  base0C: $base0C;
  base0D: $base0D;
  base0E: $base0E;
  base0F: $base0F;

  blackey: @base00;
  blue: @base0D;
  brown: @base0F;
  green: @base0B;
  orange: @base09;
  purple: @base0E;
  red: @base08;
  turqoise: @base0C;
  whitey: @base07;
  yellow: @base0A;

  foreground-on-primary: $focus_foreground;
}
EOF
}

write_sublime_theme() {
	local theme=$1
	local source_file="$SUBLIME_SOURCE_DIR/Mariana.$theme.sublime-color-scheme"

	[[ -f "$source_file" ]] || die "missing Sublime theme source for '$theme'"
	atomic_write "$SUBLIME_THEME" <"$source_file"
}

write_all() {
	local theme=$1

	load_palette "$theme"
	write_sway_colors
	write_foot_theme "$theme"
	write_tmux_theme
	write_waybar_theme
	write_gtk_theme
	write_rofi_theme
	write_sublime_theme "$theme"
	printf '%s\n' "$theme" >"$CURRENT_FILE"
}

generated_files_missing() {
	local file

	[[ -f "$CURRENT_FILE" ]] || return 0

	for file in "${GENERATED_FILES[@]}"; do
		[[ -f "$file" ]] || return 0
	done

	return 1
}

apply_sway() {
	if command -v swaymsg >/dev/null 2>&1 && swaymsg -t get_version >/dev/null 2>&1; then
		swaymsg reload >/dev/null || true
	fi
}

apply_waybar() {
	pkill -SIGUSR2 -x waybar >/dev/null 2>&1 || true
}

apply_tmux() {
	if command -v tmux >/dev/null 2>&1 && pgrep -x tmux >/dev/null 2>&1; then
		tmux source-file "$HOME/.tmux.conf" >/dev/null || true
	fi
}

apply_foot() {
	local theme=$1
	local signal=SIGUSR1

	[[ $theme == light ]] && signal=SIGUSR2
	pkill "-$signal" -x foot >/dev/null 2>&1 || true
}

apply_live() {
	local theme=$1

	if [[ ${DOTFILES_THEME_SKIP_APPLY:-0} == "1" ]]; then
		return 0
	fi

	apply_sway
	apply_waybar
	apply_tmux
	apply_foot "$theme"
}

main() {
	local command=${1:-}
	local theme

	case "$command" in
	dark | light)
		theme=$command
		write_all "$theme"
		apply_live "$theme"
		;;
	toggle)
		if [[ $(current_theme) == "dark" ]]; then
			theme=light
		else
			theme=dark
		fi

		write_all "$theme"
		apply_live "$theme"
		;;
	current)
		current_theme
		;;
	ensure)
		if generated_files_missing; then
			write_all "$(current_theme)"
		fi
		;;
	-h | --help | help)
		usage
		;;
	*)
		usage >&2
		exit 2
		;;
	esac
}

main "$@"
