#!/bin/bash
actions=(
	'suspend'
	'screen'
	'reboot'
	'shutdown'
	'logout'
	'restart'
	'poweroff'
)

suspend() {
	local can_suspend_then_hibernate

	can_suspend_then_hibernate=$(
		busctl call \
			org.freedesktop.login1 \
			/org/freedesktop/login1 \
			org.freedesktop.login1.Manager \
			CanSuspendThenHibernate \
			2>/dev/null || true
	)

	if [[ $can_suspend_then_hibernate == 's "yes"' ]]; then
		systemctl suspend-then-hibernate
	else
		systemctl suspend
	fi
}

select_action() {
	case $1 in
	screen)
		swayidle -w \
			timeout 1 'swaymsg "output * power off"' \
			resume "swaymsg \"output * power on\"; kill -TERM \"\$PPID\""
		;;
	suspend)
		suspend
		;;
	reboot | restart)
		systemctl reboot
		;;
	shutdown | poweroff)
		systemctl poweroff
		;;
	logout)
		swaymsg exit
		;;
	esac
}

if [[ $1 ]]; then
	select_action "$1"
else
	select_action "$(printf "%s\n" "${actions[@]}" | rofi -dmenu -i -theme base16-mreq-red)"
fi
